Sha256State :: struct {
    state: [8]u32
    bit_length: u64
    buffer: [64]u8
    buffer_length: s32
}

PassOptions :: struct {
    length: s32
    counter: u64
    lowercase: bool
    uppercase: bool
    digits: bool
    symbols: bool
    exclude: string
}

PassClass :: struct {
    bytes: [32]u8
    count: s32
}

PassResult :: struct {
    valid: bool
    password: [36]u8
    length: s32
    error: string
}

EntropyState :: struct {
    bytes: [32]u8
}

sha256_round_constants: [64]u32 = .[
0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b,
0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01,
0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7,
0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152,
0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08,
0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f,
0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];

Sha256RotateRight :: (value: u32, amount: u32) -> u32 {
    if amount == cast(u32)0 { return value }
    return (value >> amount) |
    (value << (cast(u32)32 - amount))
}

Sha256Initialize :: () -> Sha256State {
    state: Sha256State
    state.state[0] = 0x6a09e667
    state.state[1] = 0xbb67ae85
    state.state[2] = 0x3c6ef372
    state.state[3] = 0xa54ff53a
    state.state[4] = 0x510e527f
    state.state[5] = 0x9b05688c
    state.state[6] = 0x1f83d9ab
    state.state[7] = 0x5be0cd19
    return state
}

Sha256Compress :: (context: Sha256State, block: [64]u8) -> Sha256State {
    words: [64]u32
    for index: 0..15 {
        words[index] = (cast(u32)block[index * 4] << cast(u32)24) |
        (cast(u32)block[index * 4 + 1] << cast(u32)16) |
        (cast(u32)block[index * 4 + 2] << cast(u32)8) |
        cast(u32)block[index * 4 + 3]
    }
    for index: 16..63 {
        low_left: u32 = Sha256RotateRight(words[index - 15], cast(u32)7)
        low_first: u32
        low_first = low_left ^ Sha256RotateRight(words[index - 15], cast(u32)18)
        low: u32 = low_first ^ (words[index - 15] >> cast(u32)3)
        high_left: u32 = Sha256RotateRight(words[index - 2], cast(u32)17)
        high_first: u32
        high_first = high_left ^ Sha256RotateRight(words[index - 2], cast(u32)19)
        high: u32 = high_first ^ (words[index - 2] >> cast(u32)10)
        words[index] = words[index - 16] + low + words[index - 7] + high
    }

    a: u32 = context.state[0]
    b: u32 = context.state[1]
    c: u32 = context.state[2]
    d: u32 = context.state[3]
    e: u32 = context.state[4]
    f: u32 = context.state[5]
    g: u32 = context.state[6]
    h: u32 = context.state[7]

    for index: 0..63 {
        major_left: u32 = Sha256RotateRight(e, cast(u32)6)
        major_first: u32
        major_first = major_left ^ Sha256RotateRight(e, cast(u32)11)
        major: u32 = major_first ^ Sha256RotateRight(e, cast(u32)25)
        choose: u32 = (e & f) ^ (~e & g)
        first: u32 = h + major + choose +
        sha256_round_constants[index] + words[index]
        minor_left: u32 = Sha256RotateRight(a, cast(u32)2)
        minor_first: u32
        minor_first = minor_left ^ Sha256RotateRight(a, cast(u32)13)
        minor: u32 = minor_first ^ Sha256RotateRight(a, cast(u32)22)
        mixture: u32 = (a & b) ^ (a & c) ^ (b & c)
        second: u32 = minor + mixture

        h = g
        g = f
        f = e
        e = d + first
        d = c
        c = b
        b = a
        a = first + second
    }

    context.state[0] += a
    context.state[1] += b
    context.state[2] += c
    context.state[3] += d
    context.state[4] += e
    context.state[5] += f
    context.state[6] += g
    context.state[7] += h
    return context
}

Sha256Update :: (context: Sha256State, data: string) -> Sha256State {
    context.bit_length += cast(u64)data.count * cast(u64)8
    offset: s32 = 0
    length: s32 = cast(s32)data.count
    while offset < length {
        take: s32 = 64 - context.buffer_length
        remaining: s32 = length - offset
        if take > remaining { take = remaining }
        position: s32 = 0
        while position < take {
            context.buffer[context.buffer_length + position] =
            data[offset + position]
            position += 1
        }
        context.buffer_length += take
        offset += take
        if context.buffer_length == 64 {
            context = Sha256Compress(context, context.buffer)
            context.buffer_length = 0
        }
    }
    return context
}

Sha256Final :: (context: Sha256State) -> [32]u8 {
    bit_length: u64 = context.bit_length
    context.buffer[context.buffer_length] = cast(u8)0x80
    context.buffer_length += 1
    if context.buffer_length > 56 {
        while context.buffer_length < 64 {
            context.buffer[context.buffer_length] = cast(u8)0
            context.buffer_length += 1
        }
        context = Sha256Compress(context, context.buffer)
        context.buffer_length = 0
    }
    while context.buffer_length < 56 {
        context.buffer[context.buffer_length] = cast(u8)0
        context.buffer_length += 1
    }
    for index: 0..7 {
        shift: u64 = cast(u64)(7 - index) * cast(u64)8
        context.buffer[context.buffer_length] =
        cast(u8)(bit_length >> shift)
        context.buffer_length += 1
    }
    context = Sha256Compress(context, context.buffer)

    digest: [32]u8
    for index: 0..7 {
        digest[index * 4] = cast(u8)(context.state[index] >> cast(u32)24)
        digest[index * 4 + 1] =
        cast(u8)(context.state[index] >> cast(u32)16)
        digest[index * 4 + 2] = cast(u8)(context.state[index] >> cast(u32)8)
        digest[index * 4 + 3] = cast(u8)context.state[index]
    }
    return digest
}

Sha256 :: (data: string) -> [32]u8 {
    context := Sha256Initialize()
    context = Sha256Update(context, data)
    return Sha256Final(context)
}

HmacSha256 :: (key: string, message: string) -> [32]u8 {
    block_key: [64]u8
    if key.count > 64 {
        hashed_key := Sha256(key)
        for index: 0..31 { block_key[index] = hashed_key[index] }
    } else {
        key_length: s32 = cast(s32)key.count
        if key_length > 0 {
            index: s32 = 0
            while index < key_length {
                block_key[index] = key[index]
                index += 1
            }
        }
    }

    pad: [64]u8
    for index: 0..63 { pad[index] = block_key[index] ^ cast(u8)0x36 }
    context := Sha256Initialize()
    context = Sha256Update(context, TextView(pad[0:64]))
    context = Sha256Update(context, message)
    inner := Sha256Final(context)

    for index: 0..63 { pad[index] = block_key[index] ^ cast(u8)0x5c }
    context = Sha256Initialize()
    context = Sha256Update(context, TextView(pad[0:64]))
    context = Sha256Update(context, TextView(inner[0:32]))
    return Sha256Final(context)
}

DeriveKey :: (password: string, salt: string) -> [32]u8 {
    block_input: [512]u8
    salt_length: s32 = cast(s32)salt.count
    if salt_length > 508 { salt_length = 508 }
    if salt_length > 0 {
        index: s32 = 0
        while index < salt_length {
            block_input[index] = salt[index]
            index += 1
        }
    }
    block_input[salt_length] = cast(u8)0
    block_input[salt_length + 1] = cast(u8)0
    block_input[salt_length + 2] = cast(u8)0
    block_input[salt_length + 3] = cast(u8)1
    input_length: s32 = salt_length + 4

    output := HmacSha256(password, TextView(block_input[0:input_length]))
    previous: [32]u8 = output
    for round: 1..99999 {
        previous = HmacSha256(password, TextView(previous[0:32]))
        for index: 0..31 { output[index] ^= previous[index] }
    }
    return output
}


PassClassEmptyError :: (class_index: s32) -> string {
    if class_index == 0 {
        return "enabled lowercase character class is empty after exclusions"
    }
    if class_index == 1 {
        return "enabled uppercase character class is empty after exclusions"
    }
    if class_index == 2 {
        return "enabled digits character class is empty after exclusions"
    }
    return "enabled symbols character class is empty after exclusions"
}

PassFailure :: (message: string) -> PassResult {
    result: PassResult
    result.error = message
    return result
}

PassFilterClass :: (characters: string, options: PassOptions) -> PassClass {
    result: PassClass
    character_index: s32 = 0
    while character_index < cast(s32)characters.count {
        excluded := false
        exclude_index: s32 = 0
        while exclude_index < cast(s32)options.exclude.count {
            if options.exclude[exclude_index] == characters[character_index] {
                excluded = true
                break
            }
            exclude_index += 1
        }
        if !excluded && result.count < cast(s32)result.bytes.count {
            result.bytes[result.count] = characters[character_index]
            result.count += 1
        }
        character_index += 1
    }
    return result
}

PassAppendCounter :: (salt: []u8, offset: s32, counter: u64) -> s32 {
    digits: [16]u8
    digit_count: s32 = 0
    value := counter
    while value > cast(u64)0 {
        nibble: u64 = value % cast(u64)16
        if nibble < cast(u64)10 {
            digits[digit_count] = cast(u8)(nibble + cast(u64)48)
        } else {
            digits[digit_count] = cast(u8)(nibble + cast(u64)87)
        }
        digit_count += 1
        value /= cast(u64)16
    }
    if digit_count == 0 {
        salt[offset] = cast(u8)48
        return offset + 1
    }
    digit_index: s32 = digit_count - 1
    while digit_index >= 0 {
        salt[offset + (digit_count - digit_index - 1)] = digits[digit_index]
        digit_index -= 1
    }
    return offset + digit_count
}

EntropyTake :: (entropy: *EntropyState, divisor: s32) -> s32 {
    carry: u32 = 0
    index: s32 = 0
    while index < 32 {
        current: u32 = carry * cast(u32)256 +
        cast(u32)entropy.bytes[index]
        entropy.bytes[index] = cast(u8)(current / cast(u32)divisor)
        carry = current % cast(u32)divisor
        index += 1
    }
    return cast(s32)carry
}

PassGenerate :: (site: string, login: string, master: string,
    options: PassOptions) -> PassResult {
    if options.length < 5 || options.length > 35 {
        return PassFailure(
            "password length must be between 5 and 35")
    }

    class_sets: [4]string = .[
    "abcdefghijklmnopqrstuvwxyz", "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "0123456789", "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
    ]
    class_names: [4]string = .[
    "lowercase", "uppercase", "digits", "symbols"
    ]
    class_enabled: [4]bool = .[
    options.lowercase, options.uppercase,
    options.digits, options.symbols
    ]
    classes: [4]PassClass
    class_count: s32 = 0
    alphabet: [128]u8
    alphabet_count: s32 = 0
    class_index: s32 = 0
    while class_index < 4 {
        if class_enabled[class_index] {
            classes[class_count] = PassFilterClass(
                class_sets[class_index], options)
            if classes[class_count].count == 0 {
                return PassFailure(PassClassEmptyError(class_index))
            }
            copy_index: s32 = 0
            while copy_index < classes[class_count].count {
                alphabet[alphabet_count] =
                classes[class_count].bytes[copy_index]
                alphabet_count += 1
                copy_index += 1
            }
            class_count += 1
        }
        class_index += 1
    }
    if class_count == 0 {
        return PassFailure("at least one character class must be enabled")
    }
    if options.length < class_count {
        return PassFailure(
            "password length is smaller than the enabled character classes")
    }
    if options.length == class_count {
        return PassFailure(
            "password length must leave room for generated characters")
    }

    salt: [640]u8
    salt_length: s32 = 0
    if cast(s32)site.count >= cast(s32)salt.count {
        return PassFailure("site name is too long")
    }
    site_index: s32 = 0
    while site_index < cast(s32)site.count {
        salt[salt_length] = site[site_index]
        salt_length += 1
        site_index += 1
    }
    if salt_length + cast(s32)login.count >= cast(s32)salt.count {
        return PassFailure("login is too long")
    }
    login_index: s32 = 0
    while login_index < cast(s32)login.count {
        salt[salt_length] = login[login_index]
        salt_length += 1
        login_index += 1
    }
    salt_length = PassAppendCounter(salt[:], salt_length, options.counter)

    entropy: EntropyState
    entropy.bytes = DeriveKey(master, TextView(salt[0:salt_length]))

    password_length := options.length - class_count
    password: [36]u8
    generated_index: s32 = 0
    while generated_index < password_length {
        password[generated_index] = alphabet[EntropyTake(
            *entropy, alphabet_count)]
        generated_index += 1
    }

    required: [4]u8
    required_index: s32 = 0
    while required_index < class_count {
        required[required_index] = classes[required_index].bytes[EntropyTake(
            *entropy, classes[required_index].count)]
        required_index += 1
    }

    insertion_index: s32 = 0
    while insertion_index < class_count {
        position := EntropyTake(*entropy, password_length)
        move_index := password_length
        while move_index > position {
            password[move_index] = password[move_index - 1]
            move_index -= 1
        }
        password[position] = required[insertion_index]
        password_length += 1
        insertion_index += 1
    }

    result: PassResult
    result.valid = true
    result.length = password_length
    result_index: s32 = 0
    while result_index < password_length {
        result.password[result_index] = password[result_index]
        result_index += 1
    }
    return result
}
