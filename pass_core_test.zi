#import "pass_core"

#program_export
DigestMatches :: (left: [32]u8, right: [32]u8) -> bool {
    for index: 0..31 {
        if left[index] != right[index] { return false }
    }
    return true
}

#program_export
Answer :: () -> s32 {
    empty := Sha256("")
    abc := Sha256("abc")
    derived := DeriveKey("password", "salt")
    if empty[0] != cast(u8)0xe3 || empty[31] != cast(u8)0x55 { return 1 }
    if abc[0] != cast(u8)0xba || abc[31] != cast(u8)0xad { return 2 }
    expected: [32]u8 = .[
    0x03, 0x94, 0xa2, 0xed, 0xe3, 0x32, 0xc9, 0xa1,
    0x3e, 0xb8, 0x2e, 0x9b, 0x24, 0x63, 0x16, 0x04,
    0xc3, 0x1d, 0xf9, 0x78, 0xb4, 0xe2, 0xf0, 0xfb,
    0xd2, 0xc5, 0x49, 0x94, 0x4f, 0x9d, 0x79, 0xa5
    ]
    if !DigestMatches(derived, expected) { return 3 }
    long_password: [80]u8
    for index: 0..79 { long_password[index] = cast(u8)97 }
    long_derived := DeriveKey(TextView(long_password[0:80]), "salt")
    long_password_expected: [32]u8 = .[
    0x2f, 0xf0, 0x41, 0xc8, 0x08, 0x5d, 0xbc, 0xe4,
    0x6f, 0x9d, 0xc5, 0xa4, 0xe8, 0xb9, 0xe5, 0xeb,
    0x1d, 0x17, 0x27, 0x31, 0x8c, 0x54, 0x0f, 0x66,
    0x97, 0xb5, 0xb0, 0xa3, 0x68, 0xe1, 0x58, 0xad
    ]
    if !DigestMatches(long_derived, long_password_expected) { return 4 }
    long_salt: [700]u8
    for index: 0..699 { long_salt[index] = cast(u8)98 }
    truncated_salt := DeriveKey("password", TextView(long_salt[0:700]))
    truncated_salt_expected: [32]u8 = .[
    0x3a, 0x4d, 0x1a, 0xf4, 0xf5, 0x39, 0x07, 0x0e,
    0x6f, 0xb4, 0xb2, 0xa0, 0x70, 0x90, 0x71, 0xd0,
    0x3e, 0x01, 0xc7, 0xfb, 0x6c, 0x26, 0x59, 0xf6,
    0xa8, 0x48, 0x11, 0xea, 0xe8, 0x50, 0x15, 0x0b
    ]
    if !DigestMatches(truncated_salt, truncated_salt_expected) { return 5 }
    return 42
}

#program_export
PortableAnswer :: () -> s32 {
    digest := HmacSha256("password", "salt")
    if digest[0] != cast(u8)0xfc || digest[31] != cast(u8)0xd0 {
        return 1
    }
    return 42
}
