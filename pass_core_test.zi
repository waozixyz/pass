#import "pass_core"

#program_export
DigestMatches :: (left: [32]u8, right: [32]u8) -> bool {
    for index: 0..31 {
        if left[index] != right[index] { return false }
    }
    return true
}

#program_export
Answer :: () -> s32 {
    empty := Sha256("")
    abc := Sha256("abc")
    derived := DeriveKey("password", "salt")
    if empty[0] != cast(u8)0xe3 || empty[31] != cast(u8)0x55 { return 1 }
    if abc[0] != cast(u8)0xba || abc[31] != cast(u8)0xad { return 2 }
    expected: [32]u8 = .[
    0x03, 0x94, 0xa2, 0xed, 0xe3, 0x32, 0xc9, 0xa1,
    0x3e, 0xb8, 0x2e, 0x9b, 0x24, 0x63, 0x16, 0x04,
    0xc3, 0x1d, 0xf9, 0x78, 0xb4, 0xe2, 0xf0, 0xfb,
    0xd2, 0xc5, 0x49, 0x94, 0x4f, 0x9d, 0x79, 0xa5
    ]
    if !DigestMatches(derived, expected) { return 3 }
    long_password: [80]u8
    for index: 0..79 { long_password[index] = cast(u8)97 }
    long_derived := DeriveKey(TextView(long_password[0:80]), "salt")
    long_password_expected: [32]u8 = .[
    0x2f, 0xf0, 0x41, 0xc8, 0x08, 0x5d, 0xbc, 0xe4,
    0x6f, 0x9d, 0xc5, 0xa4, 0xe8, 0xb9, 0xe5, 0xeb,
    0x1d, 0x17, 0x27, 0x31, 0x8c, 0x54, 0x0f, 0x66,
    0x97, 0xb5, 0xb0, 0xa3, 0x68, 0xe1, 0x58, 0xad
    ]
    if !DigestMatches(long_derived, long_password_expected) { return 4 }
    long_salt: [700]u8
    for index: 0..699 { long_salt[index] = cast(u8)98 }
    truncated_salt := DeriveKey("password", TextView(long_salt[0:700]))
    truncated_salt_expected: [32]u8 = .[
    0x3a, 0x4d, 0x1a, 0xf4, 0xf5, 0x39, 0x07, 0x0e,
    0x6f, 0xb4, 0xb2, 0xa0, 0x70, 0x90, 0x71, 0xd0,
    0x3e, 0x01, 0xc7, 0xfb, 0x6c, 0x26, 0x59, 0xf6,
    0xa8, 0x48, 0x11, 0xea, 0xe8, 0x50, 0x15, 0x0b
    ]
    if !DigestMatches(truncated_salt, truncated_salt_expected) { return 5 }

    defaults := DefaultPassOptions()
    generated := PassGenerate(
        "example.com", "alice", "correct horse battery staple", defaults)
    if !PassTextMatches(generated, "&Lf4'/-cSk4DPv_8") { return 6 }

    excluded := defaults
    excluded.length = 24
    excluded.exclude = "0Ool1I!|"
    generated = PassGenerate(
        "example.com", "alice", "correct horse battery staple", excluded)
    if !PassTextMatches(
        generated, "7,.Cp}YnF'eeHHaqbX7#PQhg") { return 7 }

    subset: PassOptions
    subset.length = 12
    subset.counter = 7
    subset.lowercase = true
    subset.digits = true
    subset.exclude = ""
    generated = PassGenerate(
        "δοκιμή.example", "ユーザー", "pässword", subset)
    if !PassTextMatches(generated, "oih5omhygh2v") { return 8 }

    empty_subset: PassOptions
    empty_subset.length = 5
    empty_subset.uppercase = true
    empty_subset.digits = true
    generated = PassGenerate("x", "y", "", empty_subset)
    if !PassTextMatches(generated, "C9O9I") { return 9 }

    lesspass := PassGenerate(
        "lesspass.com", "contact@lesspass.com", "password", defaults)
    if !PassTextMatches(lesspass, "\\g-A1-.OHEwrXjT#") { return 10 }

    counters := defaults
    counters.counter = 10
    generated = PassGenerate("site", "login", "test", counters)
    if !PassTextMatches(generated, "XFt0F*,r619:+}[.") { return 11 }
    counters.counter = 16
    generated = PassGenerate("site", "login", "test", counters)
    if !PassTextMatches(generated, "l:`nzj>S7+0#uL_d") { return 12 }

    empty_inputs := PassGenerate("", "", "", defaults)
    if !PassTextMatches(empty_inputs, "bb8^CBroRNj%4sP_") { return 13 }
    invalid := defaults
    invalid.digits = true
    invalid.exclude = "0123456789"
    if PassGenerate("", "", "", invalid).valid { return 14 }

    emoji: [64]u8
    emoji_length := MasterEmoji(
        "correct horse battery staple", emoji[:])
    if !TextMatches(TextView(emoji[0:emoji_length]),
        "🐰🎨🐮🍑") { return 15 }

    empty_emoji: [64]u8
    empty_emoji_length := MasterEmoji("", empty_emoji[:])
    if empty_emoji_length != 16 ||
    !TextMatches(TextView(empty_emoji[0:empty_emoji_length]),
        "🍔🔥🐰🐭") { return 16 }

    tiny_emoji: [2]u8
    tiny_emoji[0] = cast(u8)120
    tiny_emoji_length := MasterEmoji(
        "correct horse battery staple", tiny_emoji[:])
    if tiny_emoji_length != 0 || tiny_emoji[0] != cast(u8)0 {
        return 17
    }
    return 42
}

#program_export
PortableAnswer :: () -> s32 {
    digest := HmacSha256("password", "salt")
    if digest[0] != cast(u8)0xfc || digest[31] != cast(u8)0xd0 {
        return 1
    }
    return 42
}


TextMatches :: (actual: string, expected: string) -> bool {
    if actual.count != expected.count { return false }
    index: s32 = 0
    while index < cast(s32)actual.count {
        if actual[index] != expected[index] { return false }
        index += 1
    }
    return true
}

PassTextMatches :: (result: PassResult, expected: string) -> bool {
    if !result.valid || result.length != cast(s32)expected.count {
        return false
    }
    index: s32 = 0
    while index < result.length {
        if result.password[index] != expected[index] { return false }
        index += 1
    }
    return true
}

DefaultPassOptions :: () -> PassOptions {
    options: PassOptions
    options.length = 16
    options.counter = 1
    options.lowercase = true
    options.uppercase = true
    options.digits = true
    options.symbols = true
    options.exclude = ""
    return options
}
