using UI :: #import "Widgets";
#import "runtime"
#import "pass_core"
#import "text"
#import "text_buffer"
#import "number_text"
#import "Theme"
#import "SystemTheme"
#import "theme"
#import "ScrollDevice"
#import "utf8"
#import "mini"
Fullscreen :: #import "mingcute/mingcute_regular_fullscreen_2";
#if #defined(ANDROID_BUILD) {
    #import "android_input"
}

host :: #system_library "pass_host";
HostKeyboard :: (visible: bool) #foreign host;
HostDark :: () -> bool #foreign host;
HostPalette :: () -> SystemPalette #foreign host;
HostFingerprintPath :: () -> string #foreign host;
HostOpenFullApp :: () #foreign host;

FieldState :: struct {
    cursor: s32
    anchor: s32
    scroll_x: s32
}

initialized: bool;
view: s32;
focused: s32;
fields: [5]FieldState;
site: [256]u8;
login: [256]u8;
master: [1024]u8;
profile_name: [64]u8;
reveal: bool;
scroll_offsets: [3]s32;
typed: [128]u8;
typed_length: s32;
key_pressed: s32;
modifiers: s32;
emoji: [32]u8;
theme_signature: s32 = -1;
palette: Palette;
number_buffer: [32]u8;

Label :: (session: Session, value: string, x: float32, y: float32, width: float32, font: s32) {
    props: TextProps
    props.bounds = Rectangle.{x, y, width, cast(float32)(font + 8)}
    props.text = value; props.font = font
    Text(session, props)
}

Action :: (session: Session, id: s32, label: string, bounds: Rectangle, accent: bool, disabled: bool) -> bool {
    props: ButtonProps
    props.key = cast(u64)id; props.id = id
    props.bounds = bounds; props.label = label; props.disabled = disabled
    props.tone = ButtonTone.ButtonToneNeutral
    props.emphasis = ButtonEmphasis.ButtonEmphasisSoft
    if accent {
        props.tone = ButtonTone.ButtonToneAccent
        props.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    return Button(session, props) == 1
}

ApplyEdit :: (buffer: []u8, edit: TextFieldEdit) -> bool {
    if !edit.changed { return false }
    length: s32 = 0
    while length < cast(s32)buffer.count && buffer[length] != cast(u8)0 { length += 1 }
    if edit.start < 0 || edit.end < edit.start || edit.end > length { return false }
    replacement: [1024]u8
    used := length - (edit.end - edit.start) + cast(s32)edit.replacement.count
    if used >= cast(s32)buffer.count || used >= 1024 { return false }
    position: s32 = 0
    while position < edit.start { replacement[position] = buffer[position]; position += 1 }
    index: s32 = 0
    while index < cast(s32)edit.replacement.count { replacement[position] = edit.replacement[index]; position += 1; index += 1 }
    index = edit.end
    while index < length { replacement[position] = buffer[index]; position += 1; index += 1 }
    index = 0
    while index < cast(s32)buffer.count { buffer[index] = cast(u8)0; index += 1 }
    index = 0
    while index < used { buffer[index] = replacement[index]; index += 1 }
    for index: 0..1023 { replacement[index] = cast(u8)0 }
    return true
}

Field :: (session: Session, index: s32, label: string, buffer: []u8, bounds: Rectangle, secure: bool) {
    #if #defined(ANDROID_BUILD) {
        if focused == index + 1 {
            selection := AndroidTextRead(index, buffer)
            if selection.valid { fields[index].cursor = selection.cursor; fields[index].anchor = selection.anchor }
        }
    }
    snapshot: [1024]u8
    mask: [1024]u8
    {
        props: TextFieldProps
        position: s32 = 0
        while position < cast(s32)buffer.count && position < 1023 {
            snapshot[position] = buffer[position]
            if buffer[position] == cast(u8)0 { break }
            position += 1
        }
        props.key = cast(u64)(100 + index); props.focus_id = 100 + index
        props.bounds = bounds; props.label = label
        props.value = TextUntilNul(snapshot[:])
        props.cursor = fields[index].cursor; props.anchor = fields[index].anchor
        props.scroll_x = fields[index].scroll_x
        props.focused = focused == index + 1
        props.max_bytes = cast(s32)buffer.count - 1
        props.max_codepoints = props.max_bytes
        props.secure = secure
        if secure {
            count := TextFieldCodepoints(props.value)
            if count > 1023 { count = 1023 }
            position: s32 = 0
            while position < count { mask[position] = cast(u8)42; position += 1 }
            props.display_value = TextView(mask[0:count])
        }
        if props.focused {
            props.input.text = TextView(typed[0:typed_length])
            props.input.left = key_pressed == 263; props.input.right = key_pressed == 262
            props.input.home = key_pressed == 268; props.input.end = key_pressed == 269
            props.input.backspace = key_pressed == 259; props.input.delete_forward = key_pressed == 261
            props.input.commit = key_pressed == 257; props.input.escape = key_pressed == 256
            props.input.shift = (modifiers & 1) != 0
            control := (modifiers & 2) != 0
            props.input.select_all = control && key_pressed == 65
            props.input.copy = control && key_pressed == 67
            props.input.cut = control && key_pressed == 88
            props.input.paste = control && key_pressed == 86
            if control { props.input.text = "" }
        }
        #if #defined(ANDROID_BUILD) {
            if input_available { props.input = TextFieldInput.{} }
        }
        result := TextField(session, props)
        fields[index].cursor = result.cursor; fields[index].anchor = result.anchor
        fields[index].scroll_x = result.scroll_x
        ApplyEdit(buffer, result.edit)
        if result.focused { focused = index + 1 }
        if result.escaped && focused == index + 1 { focused = 0 }
        #if #defined(ANDROID_BUILD) {
            if focused == index + 1 { AndroidTextSubmit(index, TextUntilNul(buffer), result.cursor, result.anchor, secure) }
        }
    }
    for position: 0..1023 { snapshot[position] = cast(u8)0; mask[position] = cast(u8)0 }
}

Check :: (session: Session, id: s32, label: string, value: bool, bounds: Rectangle) -> bool {
    props: CheckboxProps
    props.key = cast(u64)id; props.id = id; props.label = label
    props.bounds = bounds; props.checked = value
    return Checkbox(session, props).checked
}

Integer :: (session: Session, id: s32, label: string, value: s32, low: s32, high: s32, x: float32, y: float32, width: float32) -> s32 {
    Label(session, label, x, y + 8.0, width - 160.0, 16)
    props: SpinboxProps
    props.key = cast(u64)id; props.id = id; props.label = label
    props.bounds = Rectangle.{x + width - 150.0, y, 150.0, 38.0}
    props.value = value; props.min = low; props.max = high; props.step = 1
    props.value_text = FormatInteger(cast(s64)value, number_buffer[:])
    return Spinbox(session, props).value
}

CurrentOptions :: () -> PassOptions {
    options: PassOptions
    options.length = runtime.settings.length
    options.counter = cast(u64)runtime.settings.counter
    options.lowercase = runtime.settings.lower; options.uppercase = runtime.settings.upper
    options.digits = runtime.settings.digits; options.symbols = runtime.settings.symbols
    options.exclude = TextUntilNul(runtime.settings.exclude[:])
    return options
}

CurrentProfile :: () -> Profile {
    profile: Profile
    profile.name = profile_name; profile.site = site; profile.login = login
    profile.exclude = runtime.settings.exclude
    profile.length = runtime.settings.length; profile.counter = runtime.settings.counter
    profile.lower = runtime.settings.lower; profile.upper = runtime.settings.upper
    profile.digits = runtime.settings.digits; profile.symbols = runtime.settings.symbols
    return profile
}

MasterField :: (session: Session, x: float32, y: float32, width: float32) -> float32 {
    Label(session, "Master password", x, y, width, 14)
    Field(session, 2, "Master password", master[:], Rectangle.{x, y + 24.0, width - 86.0, 40.0}, !reveal)
    if Action(session, 13, ifx reveal then "Hide" else "Show", Rectangle.{x + width - 78.0, y + 24.0, 78.0, 40.0}, false, false) { reveal = !reveal }
    y += 76.0
    if runtime.settings.show_fingerprint && master[0] != cast(u8)0 {
        used := MasterEmoji(TextUntilNul(master[:]), emoji[:])
        position: s32 = 0
        for index: 0..3 {
            decoded := Decode(TextView(emoji[0:used]), position)
            glyph: s32 = 0
            while glyph < 63 && cast(u32)master_emoji_codepoints[glyph] != decoded.value { glyph += 1 }
            props: ImageProps
            props.asset_path = HostFingerprintPath()
            props.alt_text = TextView(emoji[position:decoded.after])
            props.bounds = Rectangle.{x + cast(float32)index * 28.0, y, 24.0, 24.0}
            props.source = Rectangle.{cast(float32)(glyph % 8) * 64.0, cast(float32)(glyph / 8) * 64.0, 64.0, 64.0}
            props.tint = palette.text
            Image(session, props)
            position = decoded.after
        }
        y += 34.0
    }
    if HasSavedMaster() {
        if Action(session, 14, "Unlock master password", Rectangle.{x, y, width, 38.0}, false, false) { focused = 0; UnlockMaster() }
        y += 48.0
    }
    return y
}

OptionsForm :: (session: Session, x: float32, y: float32, width: float32) -> float32 {
    runtime.settings.length = Integer(session, 20, "Length", runtime.settings.length, 5, 35, x, y, width)
    y += 50.0
    runtime.settings.counter = Integer(session, 21, "Counter", runtime.settings.counter, 1, 999999, x, y, width)
    y += 50.0
    part := width / 4.0
    runtime.settings.lower = Check(session, 31, "a-z", runtime.settings.lower, Rectangle.{x, y, part, 36.0})
    runtime.settings.upper = Check(session, 32, "A-Z", runtime.settings.upper, Rectangle.{x + part, y, part, 36.0})
    runtime.settings.digits = Check(session, 33, "0-9", runtime.settings.digits, Rectangle.{x + part * 2.0, y, part, 36.0})
    runtime.settings.symbols = Check(session, 34, "#", runtime.settings.symbols, Rectangle.{x + part * 3.0, y, part, 36.0})
    y += 48.0
    Label(session, "Exclude", x, y, width, 14)
    Field(session, 3, "Exclude", runtime.settings.exclude[:], Rectangle.{x, y + 24.0, width, 40.0}, false)
    return y + 76.0
}

// The expand button of mini mode, which opens the full app.
ExpandButton :: (session: Session, bounds: Rectangle) -> bool {
    props: ButtonProps
    props.key = cast(u64)800; props.id = 800
    props.bounds = bounds; props.label = "Open full app"
    props.icon_shape = Fullscreen.Shape; props.icon_only = true
    props.tone = ButtonTone.ButtonToneNeutral
    props.emphasis = ButtonEmphasis.ButtonEmphasisSoft
    return Button(session, props) == 1
}

GenerateForm :: (session: Session, x: float32, y: float32, width: float32, options: bool) {
    Label(session, "Site", x, y, width, 14)
    Field(session, 0, "Site", site[:], Rectangle.{x, y + 24.0, width, 40.0}, false)
    y += 76.0
    Label(session, "Login", x, y, width, 14)
    Field(session, 1, "Login", login[:], Rectangle.{x, y + 24.0, width, 40.0}, false)
    y += 76.0
    y = MasterField(session, x, y, width)
    if options { y = OptionsForm(session, x, y, width) }
    if Action(session, 40, "Generate", Rectangle.{x, y, width, 44.0}, true, false) {
        focused = 0
        Generate(TextUntilNul(site[:]), TextUntilNul(login[:]), TextUntilNul(master[:]), CurrentOptions())
        scroll_offsets[0] = 10000
    }
    y += 60.0
    Label(session, "Generated password", x, y, width, 14)
    y += 28.0
    props: BoxProps
    props.key = cast(u64)42; props.bounds = Rectangle.{x, y, width, 54.0}
    props.fill = ColorFromPacked(palette.surface); props.border = ColorFromPacked(palette.border); props.radius = 8.0
    Box(session, props)
    Label(session, ifx Generated() == "" then "Password will appear here" else Generated(), x + 10.0, y + 16.0, width - 20.0, 16)
    y += 68.0
    if Action(session, 41, "Copy", Rectangle.{x, y, width, 40.0}, false, false) { CopyPassword() }
}

ProfilesForm :: (session: Session, x: float32, y: float32, width: float32) {
    Label(session, "Profile name", x, y, width, 14)
    Field(session, 4, "Profile name", profile_name[:], Rectangle.{x, y + 24.0, width, 40.0}, false)
    y += 76.0
    if Action(session, 210, "Save Current Profile", Rectangle.{x, y, width, 42.0}, true, false) { SaveProfile(CurrentProfile()) }
    y += 60.0
    if runtime.profile_count == 0 { Label(session, "No saved profiles", x, y, width, 16) }
    index: s32 = 0
    while index < runtime.profile_count {
        Label(session, TextUntilNul(runtime.profiles[index].name[:]), x, y, width, 16)
        Label(session, TextUntilNul(runtime.profiles[index].site[:]), x, y + 26.0, width, 12)
        if Action(session, 300 + index, "Generate", Rectangle.{x, y + 50.0, width * 0.6 - 4.0, 36.0}, false, false) {
            GenerateProfile(index, TextUntilNul(master[:]))
            view = 0; focused = 0; scroll_offsets[0] = 10000
        }
        if Action(session, 400 + index, "Delete", Rectangle.{x + width * 0.6 + 4.0, y + 50.0, width * 0.4 - 4.0, 36.0}, false, false) { DeleteProfile(index); break }
        y += 102.0; index += 1
    }
}

SettingsForm :: (session: Session, x: float32, y: float32, width: float32) {
    runtime.settings.auto_copy = Check(session, 501, "Auto-copy after Generate", runtime.settings.auto_copy, Rectangle.{x, y, width, 36.0})
    y += 48.0
    runtime.settings.clear_seconds = Integer(session, 502, "Clipboard seconds", runtime.settings.clear_seconds, 0, 3600, x, y, width)
    y += 50.0
    runtime.settings.show_fingerprint = Check(session, 503, "Show master fingerprint", runtime.settings.show_fingerprint, Rectangle.{x, y, width, 36.0})
    y += 54.0
    Label(session, "Generation defaults", x, y, width, 20)
    y += 38.0
    y = OptionsForm(session, x, y, width)
    if Action(session, 510, "Save Settings", Rectangle.{x, y, width, 42.0}, true, false) { SaveSettings() }
    y += 60.0
    Label(session, "Secure master password", x, y, width, 20)
    y += 38.0
    y = MasterField(session, x, y, width)
    Label(session, FingerprintStatus(), x, y, width, 12)
    y += 36.0
    if Action(session, 520, "Save", Rectangle.{x, y, width / 2.0 - 4.0, 42.0}, true, !CanSaveMaster()) { focused = 0; SaveMaster(TextUntilNul(master[:])) }
    if Action(session, 522, "Forget", Rectangle.{x + width / 2.0 + 4.0, y, width / 2.0 - 4.0, 42.0}, false, !HasSavedMaster()) { ForgetMaster() }
    y += 64.0
    Label(session, "Theme Settings", x, y, width, 20)
    y += 36.0
    modes: [3]string = .{"System", "Light", "Dark"}
    if Action(session, 601, modes[runtime.settings.theme_mode], Rectangle.{x, y, width, 40.0}, false, false) { runtime.settings.theme_mode = (runtime.settings.theme_mode + 1) % 3 }
    y += 48.0
    if Action(session, 600, ifx runtime.settings.theme_source == 0 then "App colors" else "System colors", Rectangle.{x, y, width, 40.0}, false, false) { runtime.settings.theme_source = 1 - runtime.settings.theme_source }
    y += 48.0
    runtime.settings.theme_id = Integer(session, 602, "Color palette", runtime.settings.theme_id, 0, 15, x, y, width)
    y += 50.0
    if Action(session, 603, ifx runtime.settings.theme_style == 1 then "Classic widgets" else "Material widgets", Rectangle.{x, y, width, 40.0}, false, false) {
        runtime.settings.theme_style = ifx runtime.settings.theme_style == 1 then 2 else 1
        CopyText(ifx runtime.settings.theme_style == 1 then "classic" else "material", runtime.settings.style_pack[:])
    }
    y += 50.0
    if Action(session, 511, "Save Theme", Rectangle.{x, y, width, 42.0}, true, false) { SaveSettings() }
}

ApplyTheme :: () {
    dark := ResolveDark(cast(ThemePolicy)runtime.settings.theme_mode, HostDark())
    signature := cast(s32)dark + runtime.settings.theme_mode * 2 + runtime.settings.theme_source * 8 + runtime.settings.theme_id * 16 + runtime.settings.theme_style * 512
    if signature == theme_signature { return }
    theme_signature = signature
    palette = DefaultPalette(dark)
    accents: [16]u32 = .{0x7355d9ff, 0x2563ebff, 0x059669ff, 0xdb2777ff, 0xd97706ff, 0x0891b2ff, 0xdc2626ff, 0x7c3aedff, 0x4f46e5ff, 0x0d9488ff, 0x65a30dff, 0xc026d3ff, 0xea580cff, 0x0284c7ff, 0x9333eaff, 0x475569ff}
    system: SystemPalette
    system.dark = dark; system.background = palette.background; system.text = palette.text
    system.base = palette.surface; system.selected = accents[runtime.settings.theme_id]
    system.selected_text = OnColor(system.selected)
    system.danger = palette.danger; system.success = palette.success; system.warning = palette.warning
    if runtime.settings.theme_source == 1 {
        current := HostPalette()
        if current.dark == dark { system = current }
        else { system = SystemPaletteFallback(dark) }
        palette.background = system.background
    }
    InstallTheme(system, runtime.settings.theme_style == 2)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if !initialized { Initialize(); initialized = true }
    Tick()
    if runtime.has_unlocked_master {
        master = runtime.unlocked_master; runtime.unlocked_master = .{}
        runtime.has_unlocked_master = false; fields[2] = FieldState.{}
    }
    ApplyTheme()
    key_pressed = KeyboardTake(session); modifiers = KeyboardModifiers(session)
    typed_length = 0
    codepoint := TypedCodepointTake(session)
    while codepoint != 0 {
        typed_length = MasterEmojiAppendUtf8(typed[:], typed_length, cast(u32)codepoint)
        codepoint = TypedCodepointTake(session)
    }
    if key_pressed == 258 {
        if view == 0 {
            if (modifiers & 1) != 0 { focused = ((focused + 2) % 4) + 1 }
            else { focused = (focused % 4) + 1 }
        }
        if view == 1 { focused = 5 }
        if view == 2 { focused = 3 }
    }
    pointer := PointerSample(session)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down, pointer.released, PointerWheelTake(session, viewport), RuntimeNow())
    background: BoxProps
    background.key = cast(u64)1; background.bounds = viewport; background.fill = ColorFromPacked(palette.background)
    Box(session, background)
    pad: float32 = 18.0
    width := viewport.width - pad * 2.0
    if width < 80.0 { width = 80.0 }
    // Mini mode has a header with the expand button instead of the bottom
    // tabs, and only the generator.
    mini := MiniMode()
    if mini { view = 0 }
    top: float32 = ifx mini then 56.0 else 12.0
    height := viewport.height - (ifx mini then 92.0 else 110.0)
    if height < 60.0 { height = 60.0 }
    content_height: s32 = 800
    if mini {
        // Fields, Generate, and the password; the master field grows by its
        // fingerprint row and unlock button when they show.
        content_height = 440
        if runtime.settings.show_fingerprint && master[0] != cast(u8)0 { content_height += 34 }
        if HasSavedMaster() { content_height += 48 }
    }
    if view == 1 { content_height = 180 + runtime.profile_count * 102 }
    if view == 2 { content_height = 1060 }
    props: ScrollProps
    props.key = cast(u64)(10 + view)
    props.bounds = Rectangle.{viewport.x + pad, viewport.y + top, width, height}
    props.content_height = content_height; props.scroll_offset = scroll_offsets[view]
    props.scale = 1.0
    scroll := Scroll(session, props)
    scroll_offsets[view] = scroll.scroll_offset
    if scroll.opened {
        if view == 0 { GenerateForm(session, scroll.content.x, scroll.content.y, scroll.content.width - 10.0, !mini) }
        if view == 1 { ProfilesForm(session, scroll.content.x, scroll.content.y, scroll.content.width - 10.0) }
        if view == 2 { SettingsForm(session, scroll.content.x, scroll.content.y, scroll.content.width - 10.0) }
        End(session)
    }
    if mini {
        Label(session, "Pass", viewport.x + pad, viewport.y + 18.0, width - 56.0, 20)
        if ExpandButton(session, Rectangle.{viewport.x + viewport.width - pad - 40.0, viewport.y + 10.0, 40.0, 40.0}) { focused = 0; HostOpenFullApp() }
        Label(session, Status(), viewport.x + pad, viewport.y + viewport.height - 28.0, width, 12)
    } else {
        Label(session, Status(), viewport.x + pad, viewport.y + viewport.height - 88.0, width, 12)
    }
    labels: [3]string = .{"Generate", "Profiles", "Settings"}
    if !mini {
        for index: 0..2 {
            index32 := cast(s32)index
            if Action(session, 700 + index32, labels[index], Rectangle.{viewport.x + pad + cast(float32)index * width / 3.0, viewport.y + viewport.height - 58.0, width / 3.0 - 4.0, 46.0}, view == index32, false) { view = index32; focused = 0 }
        }
    }
    #if #defined(ANDROID_BUILD) {
        if focused == 0 { AndroidTextHide() }
    }
    HostKeyboard(focused != 0)
    for index: 0..127 { typed[index] = cast(u8)0 }
    return 0
}
