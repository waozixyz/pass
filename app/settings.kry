#import "kryon.h"
#import "android_host.h"
#import "app/common"

pass_save_settings :: (auto_copy: int, clear_seconds: int, show_fingerprint: int, length: int, counter: int, lower: int, upper: int, digits: int, symbols: int, exclude: const char*, theme_source: int, theme_mode: int, theme_id: int, theme_style: int) -> int #extern "pass_save_settings"
pass_set_style_pack :: (style_pack: const char*) -> int #extern "pass_set_style_pack"
pass_save_master :: (master: const char*, require_biometric: int) -> int #extern "pass_save_master"
pass_clear_master :: () -> int #extern "pass_clear_master"
pass_fingerprint_status :: () -> char* #extern "pass_fingerprint_status"
pass_master_emoji :: (master: const char*) -> char* #extern "pass_master_emoji"
AndroidSecureStoreBiometricAvailable :: () -> int #extern "AndroidSecureStoreBiometricAvailable"
AndroidSecureStoreHasSecret :: (key: const char*) -> int #extern "AndroidSecureStoreHasSecret"

state {
    settings_theme_modal_open: int = 0
}

settings_draw_master_emoji :: (x: int, y: int, master_text: [1024] char) -> int #private {
    if master_text[0] == 0 {
        return 0
    }

    font_token: int = PushTextFont("pass-emoji")
    pass_text(pass_master_emoji(master_text), x, y, Text20)
    PopTextFont(font_token)
    return Scale(32)
}

settings_draw :: (
    x: int,
    y: int,
    width: int,
    master: [1024] char,
    master_cursor: int*,
    reveal_master: int*,
    auto_copy: int*,
    clear_seconds: int*,
    show_fingerprint: int*,
    length: int*,
    counter: int*,
    lower: int*,
    upper: int*,
    digits: int*,
    symbols: int*,
    exclude: [128] char,
    exclude_cursor: int*,
    theme_source: int*,
    theme_mode: int*,
    theme_id: int*,
    theme_style: int*
) -> int {
    Checkbox((CheckboxProps){.bounds = {x, y, width, Scale(34)}, .id = 501, .label = "Auto-copy after Generate", .value = auto_copy})
    y += Scale(42)
    Slider((SliderProps){.bounds = {x, y, width, Scale(40)}, .id = 502, .label = "Clipboard seconds", .kind = NumericInt, .int_values = clear_seconds, .value_count = 1, .min = 0, .max = 3600})
    y += Scale(52)
    Checkbox((CheckboxProps){.bounds = {x, y, width, Scale(34)}, .id = 503, .label = "Show master fingerprint", .value = show_fingerprint})
    y += Scale(52)

    pass_text("Generation defaults", x, y, Text16)
    y += Scale(34)

    pass_text("Length", x, y + Scale(10), Text16)
    Spinbox((SpinboxProps){.bounds = {x + width - Scale(156), y, Scale(156), Scale(40)}, .id = 504, .min = 5, .max = 35, .step = 1, .value = length, .disabled = 0, .wrap = 0})
    y += Scale(54)

    pass_text("Counter", x, y + Scale(10), Text16)
    Spinbox((SpinboxProps){.bounds = {x + width - Scale(156), y, Scale(156), Scale(40)}, .id = 505, .min = 1, .max = 999999, .step = 1, .value = counter, .disabled = 0, .wrap = 0})
    y += Scale(58)

    Checkbox((CheckboxProps){.bounds = {x, y, width / 4, Scale(34)}, .id = 506, .label = "a-z", .value = lower})
    Checkbox((CheckboxProps){.bounds = {x + width / 4, y, width / 4, Scale(34)}, .id = 507, .label = "A-Z", .value = upper})
    Checkbox((CheckboxProps){.bounds = {x + width / 2, y, width / 4, Scale(34)}, .id = 508, .label = "0-9", .value = digits})
    Checkbox((CheckboxProps){.bounds = {x + (width / 4) * 3, y, width / 4, Scale(34)}, .id = 509, .label = "#", .value = symbols})
    y += Scale(72)

    pass_text("Exclude", x, y, Text14)
    TextField((TextFieldProps){.bounds = {x, y + Scale(22), width, Scale(38)}, .text = exclude, .text_size = 128, .cursor_position = exclude_cursor, .max_codepoints = 127, .focus_id = 512})
    y += Scale(76)

    if Button((ButtonProps){.bounds = {x, y, width, Scale(42)}, .label = "Save Settings", .tone = ButtonToneAccent, .emphasis = ButtonEmphasisFilled, .id = 510}) {
        pass_save_settings(*auto_copy, *clear_seconds, *show_fingerprint, *length, *counter, *lower, *upper, *digits, *symbols, exclude, *theme_source, *theme_mode, *theme_id, *theme_style)
    }
    y += Scale(60)

    pass_text("Secure master password", x, y, Text16)
    y += Scale(34)
    pass_text("Master password", x, y, Text14)
    action_size: int = Scale(42)
    action_gap: int = Scale(8)
    field_w: int = width - action_size - action_gap
    if field_w < Scale(120) {
        field_w = Scale(120)
    }
    if *reveal_master == 0 {
        TextField((TextFieldProps){.bounds = {x, y + Scale(22), field_w, Scale(38)}, .text = master, .text_size = 1024, .cursor_position = master_cursor, .max_codepoints = 1023, .focus_id = 530, .secure = 1})
    } else {
        TextField((TextFieldProps){.bounds = {x, y + Scale(22), field_w, Scale(38)}, .text = master, .text_size = 1024, .cursor_position = master_cursor, .max_codepoints = 1023, .focus_id = 530, .secure = 0})
    }
    reveal_icon: int = ICON_EYE
    if *reveal_master == 1 {
        reveal_icon = ICON_EYE_OFF
    }
    if Button((ButtonProps){.bounds = {x + width - action_size, y + Scale(22), action_size, Scale(38)}, .label = "Reveal master password", .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .icon_type = reveal_icon, .icon_only = 1, .id = 531}) {
        *reveal_master = 1 - *reveal_master
    }
    y += Scale(64)
    y += settings_draw_master_emoji(x, y, master)
    y += Scale(12)

    pass_text(pass_fingerprint_status(), x, y, Text12)
    y += Scale(30)

    if Button((ButtonProps){.bounds = {x, y, width / 2 - Scale(6), Scale(42)}, .label = "Save", .tone = ButtonToneAccent, .emphasis = ButtonEmphasisFilled, .id = 520, .disabled = AndroidSecureStoreBiometricAvailable() == 0}) {
        pass_save_master(master, 1)
    }
    if Button((ButtonProps){.bounds = {x + width / 2 + Scale(6), y, width / 2 - Scale(6), Scale(42)}, .label = "Forget", .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .id = 522, .disabled = AndroidSecureStoreHasSecret("default") == 0}) {
        pass_clear_master()
    }
    y += Scale(60)

    if Button((ButtonProps){.bounds = {x, y, width, Scale(42)}, .label = "Theme Settings", .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .id = 500}) {
        ClearFocus()
        SetFocusTextInputActive(0)
        ConsumeRelease()
        settings_theme_modal_open = 1
    }

    return y + Scale(52)
}

settings_theme_modal_is_open :: () -> int {
    return settings_theme_modal_open
}

settings_content_height :: (master: [1024] char) -> int {
    height: int = 0

    height += Scale(42)
    height += Scale(52)
    height += Scale(52)
    height += Scale(34)
    height += Scale(54)
    height += Scale(58)
    height += Scale(72)
    height += Scale(76)
    height += Scale(60)
    height += Scale(34)
    height += Scale(64)
    if master[0] != 0 {
        height += Scale(32)
    }
    height += Scale(12)
    height += Scale(30)
    height += Scale(60)
    height += Scale(52)

    return height
}

settings_draw_theme_modal :: (
    auto_copy: int*,
    clear_seconds: int*,
    show_fingerprint: int*,
    length: int*,
    counter: int*,
    lower: int*,
    upper: int*,
    digits: int*,
    symbols: int*,
    exclude: [128] char,
    theme_source: int*,
    theme_mode: int*,
    theme_id: int*,
    theme_style: int*
) {
    if settings_theme_modal_open == 0 {
        return
    }

    modal_w: int = GetScreenWidth() - Scale(32)
    modal_h: int = Scale(380)
    frame := RenderModalFrame(modal_w, modal_h, "Theme Settings", (Texture2D){0}, (Texture2D){0})
    if frame.right_clicked == 1 {
        ClearFocus()
        SetFocusTextInputActive(0)
        ConsumeRelease()
        settings_theme_modal_open = 0
    }

    source_options: [2] const char* = {"App colors", "System colors"}
    mode_options: [3] const char* = {"System", "Light", "Dark"}
    palette_options: [THEME_COUNT] const char*
    palette_index: int = 0
    while palette_index < THEME_COUNT {
        palette_options[palette_index] = GetThemeLabel((ThemeId)palette_index)
        palette_index += 1
    }

    control_x: int = frame.content_x
    control_w: int = frame.content_w
    control_y: int = frame.content_y
    pass_text("Color source", control_x, control_y, Text14)
    Dropdown((DropdownProps){.bounds = {control_x, control_y + Scale(22), control_w, Scale(38)}, .id = 600, .options = source_options, .option_count = 2, .selected_index = theme_source})
    control_y += Scale(76)
    pass_text("Color mode", control_x, control_y, Text14)
    Dropdown((DropdownProps){.bounds = {control_x, control_y + Scale(22), control_w, Scale(38)}, .id = 601, .options = mode_options, .option_count = 3, .selected_index = theme_mode})
    control_y += Scale(76)
    pass_text("Color palette", control_x, control_y, Text14)
    Dropdown((DropdownProps){.bounds = {control_x, control_y + Scale(22), control_w, Scale(38)}, .id = 602, .options = palette_options, .option_count = THEME_COUNT, .selected_index = theme_id})
    control_y += Scale(76)
    pass_text("Widget style", control_x, control_y, Text14)
    if StylePicker((StylePickerProps){.bounds = {control_x, control_y + Scale(22), control_w, Scale(38)}, .id = 603}) {
        pass_set_style_pack(GetActiveStylePackId())
    }

    save_y: int = frame.content_y + frame.content_h - Scale(44)
    if Button((ButtonProps){.bounds = {frame.content_x, save_y, frame.content_w, Scale(40)}, .label = "Save Theme", .tone = ButtonToneAccent, .emphasis = ButtonEmphasisFilled, .id = 511}) {
        pass_save_settings(*auto_copy, *clear_seconds, *show_fingerprint, *length, *counter, *lower, *upper, *digits, *symbols, exclude, *theme_source, *theme_mode, *theme_id, *theme_style)
        ClearFocus()
        SetFocusTextInputActive(0)
        ConsumeRelease()
        settings_theme_modal_open = 0
    }
}

// Block the underlying form before drawing the modal's interactive controls.
settings_capture_theme_input :: () {
    if settings_theme_modal_open == 1 {
        PushInputCapture((Rectangle){0, 0, GetFrameWidth(), GetFrameHeight()}, 0)
    }
}
