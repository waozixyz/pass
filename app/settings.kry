#import "kryon.h"

pass_save_settings :: (auto_copy: int, clear_seconds: int, show_fingerprint: int, length: int, counter: int, lower: int, upper: int, digits: int, symbols: int, exclude: const char*, theme_source: int, theme_mode: int, theme_id: int, theme_style: int) -> int #extern "pass_save_settings"
pass_save_master :: (master: const char*, require_biometric: int) -> int #extern "pass_save_master"
pass_clear_master :: () -> int #extern "pass_clear_master"
pass_biometric_available :: () -> int #extern "pass_biometric_available"
pass_master_saved :: () -> int #extern "pass_master_saved"
pass_fingerprint_status :: () -> char* #extern "pass_fingerprint_status"
pass_master_emoji :: (master: const char*) -> char* #extern "pass_master_emoji"

state {
    settings_theme_modal_open: int = 0
    settings_icons_loaded: int = 0
    settings_close_icon: Texture2D
    settings_eye_icon: Texture2D
    settings_eye_off_icon: Texture2D
}

settings_load_icons :: () #private {
    if settings_icons_loaded == 1 {
        return
    }

    settings_close_icon = LoadUIIconTexture(UI_ICON_TYPE_X)
    settings_eye_icon = LoadUIIconTexture(UI_ICON_TYPE_EYE)
    settings_eye_off_icon = LoadUIIconTexture(UI_ICON_TYPE_EYE_OFF)
    settings_icons_loaded = 1
}

settings_draw_master_emoji :: (x: int, y: int, master_text: [1024] char) -> int #private {
    if master_text[0] == 0 {
        return 0
    }

    font_token: int = PushUIFont("pass-emoji")
    Text(pass_master_emoji(master_text), x, y, Text20, GetThemeIcon())
    PopUIFont(font_token)
    return ScaleUIPx(32)
}

settings_draw :: (
    x: int,
    y: int,
    width: int,
    master: [1024] char,
    master_cursor: int*,
    reveal_master: int*,
    auto_copy: int*,
    clear_seconds: int*,
    show_fingerprint: int*,
    length: int*,
    counter: int*,
    lower: int*,
    upper: int*,
    digits: int*,
    symbols: int*,
    exclude: [128] char,
    exclude_cursor: int*,
    theme_source: int*,
    theme_mode: int*,
    theme_id: int*,
    theme_style: int*
) -> int {
    settings_load_icons()

    Checkbox(501, x, y, "Auto-copy after Generate", auto_copy)
    y += ScaleUIPx(42)
    Slider(502, x, y, width, "Clipboard seconds", 0, 3600, clear_seconds, "", nil)
    y += ScaleUIPx(52)
    Checkbox(503, x, y, "Show master fingerprint", show_fingerprint)
    y += ScaleUIPx(52)

    Text("Generation defaults", x, y, Text16, GetThemeText())
    y += ScaleUIPx(34)

    Text("Length", x, y + ScaleUIPx(10), Text16, GetThemeText())
    Spinbox((SpinboxProps){.bounds = {x + width - ScaleUIPx(156), y, ScaleUIPx(156), ScaleUIPx(40)}, .id = 504, .min = 4, .max = 128, .step = 1, .value = length, .disabled = 0, .wrap = 0})
    y += ScaleUIPx(54)

    Text("Counter", x, y + ScaleUIPx(10), Text16, GetThemeText())
    Spinbox((SpinboxProps){.bounds = {x + width - ScaleUIPx(156), y, ScaleUIPx(156), ScaleUIPx(40)}, .id = 505, .min = 1, .max = 999999, .step = 1, .value = counter, .disabled = 0, .wrap = 0})
    y += ScaleUIPx(58)

    Checkbox(506, x, y, "a-z", lower)
    Checkbox(507, x + width / 4, y, "A-Z", upper)
    Checkbox(508, x + width / 2, y, "0-9", digits)
    Checkbox(509, x + (width / 4) * 3, y, "#", symbols)
    y += ScaleUIPx(72)

    Text("Exclude", x, y, Text14, GetThemeText())
    TextField((TextFieldProps){.bounds = {x, y + ScaleUIPx(22), width, ScaleUIPx(38)}, .text = exclude, .text_size = 128, .cursor_position = exclude_cursor, .max_codepoints = 127, .font = Text16, .focus_id = 512})
    y += ScaleUIPx(76)

    if Button((ButtonProps){.bounds = {x, y, width, ScaleUIPx(42)}, .label = "Save Settings", .style = ButtonStylePrimary, .font = Text16, .id = 510}) {
        pass_save_settings(*auto_copy, *clear_seconds, *show_fingerprint, *length, *counter, *lower, *upper, *digits, *symbols, exclude, *theme_source, *theme_mode, *theme_id, *theme_style)
    }
    y += ScaleUIPx(60)

    Text("Secure master password", x, y, Text16, GetThemeText())
    y += ScaleUIPx(34)
    Text("Master password", x, y, Text14, GetThemeText())
    action_size: int = ScaleUIPx(42)
    action_gap: int = ScaleUIPx(8)
    field_w: int = width - action_size - action_gap
    if field_w < ScaleUIPx(120) {
        field_w = ScaleUIPx(120)
    }
    if *reveal_master == 0 {
        TextField((TextFieldProps){.bounds = {x, y + ScaleUIPx(22), field_w, ScaleUIPx(38)}, .text = master, .text_size = 1024, .cursor_position = master_cursor, .max_codepoints = 1023, .font = Text16, .focus_id = 530, .secure = 1})
    } else {
        TextField((TextFieldProps){.bounds = {x, y + ScaleUIPx(22), field_w, ScaleUIPx(38)}, .text = master, .text_size = 1024, .cursor_position = master_cursor, .max_codepoints = 1023, .font = Text16, .focus_id = 530, .secure = 0})
    }
    reveal_icon: Texture2D = settings_eye_icon
    if *reveal_master == 1 {
        reveal_icon = settings_eye_off_icon
    }
    if IconButton((IconButtonProps){.bounds = {x + width - action_size, y + ScaleUIPx(22), action_size, ScaleUIPx(38)}, .icon = reveal_icon, .icon_size = ScaleUIPx(22), .icon_padding = ScaleUIPx(8), .focus_id = 531, .background = GetThemeButton(), .hover_background = GetThemeButtonHover(), .icon_color = WHITE, .border = Fade(GetThemeIcon(), 0.35f), .radius = 0.10f}) {
        *reveal_master = 1 - *reveal_master
    }
    y += ScaleUIPx(64)
    y += settings_draw_master_emoji(x, y, master)
    y += ScaleUIPx(12)

    Text(pass_fingerprint_status(), x, y, Text12, GetThemeIcon())
    y += ScaleUIPx(30)

    if Button((ButtonProps){.bounds = {x, y, width / 2 - ScaleUIPx(6), ScaleUIPx(42)}, .label = "Save", .style = ButtonStylePrimary, .font = Text16, .id = 520, .disabled = pass_biometric_available() == 0}) {
        pass_save_master(master, 1)
    }
    if Button((ButtonProps){.bounds = {x + width / 2 + ScaleUIPx(6), y, width / 2 - ScaleUIPx(6), ScaleUIPx(42)}, .label = "Forget", .style = ButtonStyleSecondary, .font = Text16, .id = 522, .disabled = pass_master_saved() == 0}) {
        pass_clear_master()
    }
    y += ScaleUIPx(60)

    if Button((ButtonProps){.bounds = {x, y, width, ScaleUIPx(42)}, .label = "Theme Settings", .style = ButtonStyleSecondary, .font = Text16, .id = 500}) {
        settings_theme_modal_open = 1
    }

    return y + ScaleUIPx(52)
}

settings_theme_modal_is_open :: () -> int {
    return settings_theme_modal_open
}

settings_content_height :: () -> int {
    return ScaleUIPx(940)
}

settings_draw_theme_modal :: (
    auto_copy: int*,
    clear_seconds: int*,
    show_fingerprint: int*,
    length: int*,
    counter: int*,
    lower: int*,
    upper: int*,
    digits: int*,
    symbols: int*,
    exclude: [128] char,
    theme_source: int*,
    theme_mode: int*,
    theme_id: int*,
    theme_style: int*,
    theme_menu_state: UIThemeSettingsState*
) {
    if settings_theme_modal_open == 0 {
        return
    }

    settings_load_icons()

    empty_icon: Texture2D = {0}
    modal_w: int = GetScreenWidth() - ScaleUIPx(32)
    modal_h: int = ScaleUIPx(380)
    frame := ModalFrame(modal_w, modal_h, "Theme Settings", empty_icon, settings_close_icon)
    if frame.right_clicked == 1 {
        settings_theme_modal_open = 0
    }

    settings := (ThemeSettingsProps){
        .id_base = 600,
        .x = frame.content_x,
        .y = frame.content_y,
        .w = frame.content_w,
        .theme_source = theme_source,
        .theme_mode = theme_mode,
        .theme_id = theme_id,
        .theme_style = theme_style,
        .allow_system_source = 1,
        .allow_system_mode = 1,
        .palette_label = "Color palette",
        .source_system_label = "System colors",
        .style_label = "Widget style",
        .style_system_label = "System style"
    }
    ThemeSettings(settings, theme_menu_state, nil)

    save_y: int = frame.content_y + frame.content_h - ScaleUIPx(44)
    if Button((ButtonProps){.bounds = {frame.content_x, save_y, frame.content_w, ScaleUIPx(40)}, .label = "Save Theme", .style = ButtonStylePrimary, .font = Text16, .id = 511}) {
        pass_save_settings(*auto_copy, *clear_seconds, *show_fingerprint, *length, *counter, *lower, *upper, *digits, *symbols, exclude, *theme_source, *theme_mode, *theme_id, *theme_style)
        settings_theme_modal_open = 0
    }
}
