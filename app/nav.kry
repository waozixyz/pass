#import "kryon.h"

nav_draw :: (x: int, y: int, width: int, height: int, view: int*) {
    generate_active: int = 0
    profiles_active: int = 0
    settings_active: int = 0
    if *view == 0 {
        generate_active = 1
    }
    if *view == 1 {
        profiles_active = 1
    }
    if *view == 2 {
        settings_active = 1
    }

    items: [3] NavigationBarItem = {
        {.route = 0, .label = "Generate", .icon_type = ICON_HOME, .active = generate_active},
        {.route = 1, .label = "Profiles", .icon_type = ICON_PROFILE, .active = profiles_active},
        {.route = 2, .label = "Settings", .icon_type = ICON_GEAR, .active = settings_active}
    }

    result := NavigationBar((NavigationBarProps){
        .view_width = GetFrameWidth(),
        .view_height = GetFrameHeight(),
        .count = 3,
        .items = items,
        .height = height
    })

    if result.clicked_route >= 0 {
        *view = result.clicked_route
    }
}
