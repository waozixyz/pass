#import "kryon.h"
#import "app/common"

pass_profile_count :: () -> int #extern "pass_profile_count"
pass_profile_label :: (index: int) -> char* #extern "pass_profile_label"
pass_generate_profile :: (index: int, master: const char*) -> int #extern "pass_generate_profile"
pass_delete_profile :: (index: int) -> int #extern "pass_delete_profile"

profiles_draw_list :: (x: int, y: int, width: int, master: [1024] char) -> int {
    count: int = pass_profile_count()

    if count == 0 {
        pass_text("No saved profiles", x, y, Text16)
        return y + Scale(48)
    }

    for int i = 0; i < count; i++ {
        row_y: int = y + i * Scale(48)

        pass_text(pass_profile_label(i), x, row_y + Scale(10), Text16)
        if Button((ButtonProps){.bounds = {x + width - Scale(170), row_y, Scale(88), Scale(36)}, .label = "Generate", .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .size = ControlSizeSmall, .id = 300 + i}) {
            pass_generate_profile(i, master)
        }
        if Button((ButtonProps){.bounds = {x + width - Scale(74), row_y, Scale(74), Scale(36)}, .label = "Delete", .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .size = ControlSizeSmall, .id = 400 + i}) {
            pass_delete_profile(i)
        }
    }

    return y + count * Scale(48)
}

profiles_content_height :: () -> int {
    count: int = pass_profile_count()
    list_h: int = Scale(48)
    if count > 0 {
        list_h = count * Scale(48)
    }
    return Scale(76) + Scale(58) + list_h + Scale(110)
}
